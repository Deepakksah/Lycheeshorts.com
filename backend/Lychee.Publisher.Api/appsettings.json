{
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:3002"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=lychee_dev.db"
  },
  "Storage": {
    "Provider": "Local",
    "Container": "lychee"
  },
  "Jwt": {
    "Issuer": "Lychee.Publisher",
    "Audience": "Lychee.Publisher.Web",
    "SigningKey": "REPLACE_WITH_64_CHARACTER_KEY_FROM_KEY_VAULT_OR_SECRETS_MANAGER",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "SocialPlatforms": {
    "YouTube": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
      "RedirectUri": "http://localhost:3000/oauth/callback?platform=1"
    },
    "Meta": {
      "AppId": "YOUR_META_APP_ID",
      "AppSecret": "YOUR_META_APP_SECRET",
      "RedirectUri": "http://localhost:3000/oauth/callback?platform=2"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
